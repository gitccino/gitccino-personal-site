{
  "name": "@gitccino/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "API_BOOT_CHECK=1 bun --watch --preload ./src/instrument.ts src/index.ts",
    "start": "bun --preload ./src/instrument.ts src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent bun --env-file=../../.env test --path-ignore-patterns='src/test/integration/**'",
    "test:integration": "LOG_LEVEL=silent bun --env-file=../../.env test --timeout 10000 --preload ./src/test/integration/setup.ts src/test/integration",
    "db:verify": "bun src/db/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "bun src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:test:studio": "DATABASE_URL=\"$TEST_DATABASE_URL\" drizzle-kit studio"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@sentry/bun": "^10.71.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  }
}
