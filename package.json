{
  "name": "gitccino",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @gitccino/web dev",
    "dev:api": "bun --env-file=.env run --filter @gitccino/api dev",
    "api:typecheck": "bun run --filter @gitccino/api typecheck",
    "api:docker:build": "docker compose build api",
    "api:docker:up": "docker compose up -d --wait api",
    "api:docker:stop": "docker compose stop api",
    "api:docker:logs": "docker compose logs -f api",
    "api:docker:migrate": "docker compose run --rm api bun run db:migrate:runtime",
    "build": "bun --filter @gitccino/web build",
    "lint": "bun run --filter @gitccino/web lint",
    "preview": "bun run --filter @gitccino/web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:verify": "bun --env-file=.env run --filter @gitccino/api db:verify",
    "db:generate": "bun --env-file=.env run --filter @gitccino/api db:generate",
    "db:migrate": "bun --env-file=.env run --filter @gitccino/api db:migrate",
    "db:check": "bun --env-file=.env run --filter @gitccino/api db:check",
    "db:studio": "bun --env-file=.env run --filter @gitccino/api db:studio",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:test:down": "docker compose stop db-test",
    "db:test:logs": "docker compose logs -f db-test",
    "db:test:studio": "bun --env-file=.env run --filter @gitccino/api db:test:studio",
    "test:api": "bun run --filter @gitccino/api test",
    "test:integration": "bun run --filter @gitccino/api test:integration"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
