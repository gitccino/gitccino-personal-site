POSTGRES_DB=gitccino
POSTGRES_USER=gitccino
POSTGRES_PASSWORD=gitccino_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_PORT/$POSTGRES_DB

POSTGRES_TEST_DB=gitccino_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_TEST_PORT/$POSTGRES_TEST_DB

API_PORT=3000

NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LOG_LEVEL=info
# DSN — Data source name
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
